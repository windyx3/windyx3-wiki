---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContentList from '../components/ContentList.astro';
import { entries } from '../lib/content';
import { site } from '../site.config';
const notes = await entries('notes');
const posts = await entries('blog');
---
<BaseLayout>
  <div class="shell home">
    <section class="hero">
      <div class="hero-copy"><span class="eyebrow"><span class="live-dot" aria-hidden="true"></span> A LITTLE CORNER OF THE INTERNET</span><h1>你好，我是 <span>windyx3</span><span class="hero-period">.</span><br />欢迎来到我的<br /><em>数字花园。</em></h1><p>记录学习、编程，以及生活里值得留下的小事。<br />这里有尚未完成的想法，也有慢慢长出的答案。</p><div class="hero-links"><a class="primary-link" href="/notes/">随便逛逛 <span aria-hidden="true">↗</span></a><a class="text-link" href="/about/">关于我 →</a></div></div>
      <div class="garden-art" aria-hidden="true"><span class="art-label">FIELD NOTES / 001</span><svg viewBox="0 0 330 370" fill="none"><defs><pattern id="dots" width="18" height="18" patternUnits="userSpaceOnUse"><circle cx="1" cy="1" r="1" fill="currentColor" opacity=".16"/></pattern></defs><rect width="330" height="370" fill="url(#dots)"/><ellipse cx="163" cy="300" rx="88" ry="15" stroke="currentColor" opacity=".25"/><path d="M164 291C164 224 163 153 179 91M165 249C138 212 122 182 102 160M165 200C192 174 216 153 242 145" stroke="currentColor" stroke-width="2"/><path d="M179 132C141 115 146 68 188 54C202 91 205 116 179 132Z" fill="currentColor" opacity=".14" stroke="currentColor" stroke-width="1.5"/><path d="M148 223C111 230 80 201 86 154C129 154 151 183 148 223Z" fill="currentColor" opacity=".2" stroke="currentColor" stroke-width="1.5"/><path d="M192 177C190 133 232 115 266 128C258 165 232 190 192 177Z" fill="currentColor" opacity=".15" stroke="currentColor" stroke-width="1.5"/><path d="M179 131L188 68M145 215L97 168M198 175L253 135" stroke="currentColor" stroke-width="1.2"/><path d="M133 284H193L183 329H144L133 284Z" fill="var(--bg)" stroke="currentColor" stroke-width="1.5"/><path d="M131 284H195" stroke="currentColor" stroke-width="3"/><path d="M64 90h18m-9-9v18M258 237h12m-6-6v12" stroke="currentColor" opacity=".45"/></svg><span class="art-caption">a work in progress, always.</span><span class="art-number">慢慢生长 / EST. 2026</span></div>
    </section>
    <div class="home-divider"><span>保持好奇，持续记录。</span><span>NOTES, CODE & LITTLE DISCOVERIES</span></div>
    <section class="now-grid" aria-label="最近在做什么"><div><span class="eyebrow">01 / CURRENTLY LEARNING</span><h2>最近在学</h2><ul>{site.learning.map(item => <li><span class="small-dot" aria-hidden="true"></span>{item}</li>)}</ul></div><div><span class="eyebrow">02 / CURRENTLY BUILDING</span><h2>最近在做</h2><ul>{site.building.map(item => <li><span class="small-dot" aria-hidden="true"></span>{item}</li>)}</ul><a class="subtle-link" href="/projects/">看看我的项目 →</a></div></section>
    <section class="recent-grid"><div><div class="section-heading"><div><span class="eyebrow">THE KNOWLEDGE PATCH</span><h2>新长出的笔记<span class="count">{notes.length.toString().padStart(2, '0')}</span></h2></div><a href="/notes/" aria-label="查看全部笔记">全部 →</a></div><ContentList items={notes.slice(0, 3)} compact /></div><div><div class="section-heading"><div><span class="eyebrow">THOUGHTS ALONG THE WAY</span><h2>最近的随笔<span class="count">{posts.length.toString().padStart(2, '0')}</span></h2></div><a href="/blog/" aria-label="查看全部随笔">全部 →</a></div><ContentList items={posts.slice(0, 3)} compact /></div></section>
    <section class="interests-strip"><div><span class="eyebrow">BEYOND THE CODE</span><h2>也喜欢这些。</h2><p>代码之外，还有很多值得探索的东西。</p></div><div class="interest-chips"><a href="/interests/#reading">↗ 阅读</a><a href="/interests/#tools">⌘ 好用的工具</a><a href="/interests/#websites">✳ 互联网漫游</a><a href="/interests/#life">☕ 生活里的小事</a></div></section>
  </div>
</BaseLayout>

