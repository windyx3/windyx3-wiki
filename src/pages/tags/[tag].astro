---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentList from '../../components/ContentList.astro';
import { allEntries } from '../../lib/content';
export async function getStaticPaths() {
  const content = await allEntries();
  return [...new Set(content.flatMap(entry => entry.data.tags))].map(tag => ({ params: { tag }, props: { tag, items: content.filter(entry => entry.data.tags.includes(tag)).sort((a, b) => b.data.date.getTime() - a.data.date.getTime()) } }));
}
const { tag, items } = Astro.props;
---
<BaseLayout title={`Tag: ${tag}`}><div class="shell index-page"><header class="page-heading"><a class="back-link" href="/tags/">← All tags</a><h1>#{tag}<span class="heading-dot">.</span></h1><p>{items.length} related entries</p></header><ContentList items={items} /></div></BaseLayout>
