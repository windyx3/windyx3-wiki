---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { allEntries, tagUrl } from '../../lib/content';
const content = await allEntries();
const tags = [...new Set(content.flatMap(entry => entry.data.tags))].sort((a, b) => a.localeCompare(b, 'en'));
---
<BaseLayout title="Tags"><div class="shell index-page"><header class="page-heading"><span class="eyebrow">CONNECT THE DOTS</span><h1>Follow the connections<span class="heading-dot">.</span></h1><p>Different notes and ideas sometimes meet in the same place.</p></header><div class="tag-cloud">{tags.map(tag => <a href={tagUrl(tag)}>#{tag}<span>{content.filter(entry => entry.data.tags.includes(tag)).length}</span></a>)}</div></div></BaseLayout>
