---
import BaseLayout from '../layouts/BaseLayout.astro';
import { interests } from '../data/interests';
---
<BaseLayout title="Interests & favorites" description="Tools, books, websites, and little discoveries from everyday life."><div class="shell index-page"><header class="page-heading"><span class="eyebrow">A CABINET OF CURIOSITIES</span><h1>Things worth keeping<span class="heading-dot">.</span></h1><p>Useful tools, books to read, and small corners found while wandering the web.</p></header><p class="sample-notice">These are starter examples. Replace them with your personal collection in src/data/interests.ts.</p>{interests.map(group => <section class="favorite-group" id={group.id}><div class="section-heading"><h2>{group.title}</h2><span class="muted">{group.subtitle}</span></div><ul>{group.items.map(item => <li><div>{item.url ? <a href={item.url}>{item.name} ↗</a> : <h3>{item.name}</h3>}<p>{item.description}</p></div></li>)}</ul></section>)}</div></BaseLayout>
