---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WikiSidebar from '../../components/WikiSidebar.astro';
import ContentList from '../../components/ContentList.astro';
import { entries } from '../../lib/content';
const notes = await entries('notes');
const groups = [...new Set(notes.map(note => note.data.category))];
---
<BaseLayout title="笔记 / Wiki" description="按主题整理的学习笔记、编程知识与算法记录。"><div class="shell article-grid wiki"><WikiSidebar /><div class="article-body"><header class="page-heading"><span class="eyebrow">THE KNOWLEDGE PATCH</span><h1>笔记 / Wiki<span class="heading-dot">.</span></h1><p>把零散的知识连接起来。<br />这里的笔记会随着理解不断更新，不必每一篇都完美。</p></header><div class="topic-links">{groups.map((group, index) => <a class="tag" href={`#topic-${index}`}>{group}</a>)}</div>{groups.map((group, index) => <section class="topic-section" id={`topic-${index}`}><h2>{group}<span class="count">{notes.filter(note => note.data.category === group).length}</span></h2><ContentList items={notes.filter(note => note.data.category === group)} /></section>)}</div></div></BaseLayout>
