---
import BaseLayout from '../../layouts/BaseLayout.astro';
import WikiSidebar from '../../components/WikiSidebar.astro';
import ContentList from '../../components/ContentList.astro';
import { entries } from '../../lib/content';
const notes = await entries('notes');
const groups = [...new Set(notes.map(note => note.data.category))];
---
<BaseLayout title="Notes / Wiki" description="Learning notes, programming concepts, and algorithm practice, organized by topic."><div class="shell article-grid wiki"><WikiSidebar /><div class="article-body"><header class="page-heading"><span class="eyebrow">THE KNOWLEDGE PATCH</span><h1>Notes / Wiki<span class="heading-dot">.</span></h1><p>Connecting the pieces of what I learn.<br />These notes evolve with my understanding. They do not have to be perfect.</p></header><div class="topic-links">{groups.map((group, index) => <a class="tag" href={`#topic-${index}`}>{group}</a>)}</div>{groups.map((group, index) => <section class="topic-section" id={`topic-${index}`}><h2>{group}<span class="count">{notes.filter(note => note.data.category === group).length}</span></h2><ContentList items={notes.filter(note => note.data.category === group)} /></section>)}</div></div></BaseLayout>
