---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentList from '../../components/ContentList.astro';
import { entries } from '../../lib/content';
const projects = await entries('projects');
---
<BaseLayout title="Projects" description="Personal projects and build notes by windyx3."><div class="shell index-page"><header class="page-heading"><span class="eyebrow">MADE WITH CURIOSITY</span><h1>Making ideas real<span class="heading-dot">.</span></h1><p>Start with a small question. Make something interesting.<br />A record of the process and the decisions along the way.</p></header><div class="list-label"><span>Projects & build notes</span><span>{projects.length} projects</span></div><ContentList items={projects} /></div></BaseLayout>
