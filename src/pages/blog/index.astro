---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ContentList from '../../components/ContentList.astro';
import { entries } from '../../lib/content';
const posts = await entries('blog');
---
<BaseLayout title="Blog" description="Technical writing, personal reflections, and everyday discoveries."><div class="shell index-page"><header class="page-heading"><span class="eyebrow">THOUGHTS ALONG THE WAY</span><h1>Thoughts along the way<span class="heading-dot">.</span></h1><p>Discoveries while coding, questions while learning, and passing thoughts.<br />Writing is another way to make sense of things.</p></header><div class="list-label"><span>All posts</span><span>{posts.length} entries</span></div><ContentList items={posts} /></div></BaseLayout>
