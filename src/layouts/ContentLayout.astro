---
import BaseLayout from './BaseLayout.astro';
import WikiSidebar from '../components/WikiSidebar.astro';
import { type Entry, entryUrl, dateLabel, tagUrl, entries, sectionNames } from '../lib/content';
import type { MarkdownHeading } from 'astro';
interface Props { entry: Entry; headings: MarkdownHeading[] }
const { entry, headings } = Astro.props;
const wiki = entry.collection === 'notes';
const siblings = await entries(entry.collection);
const index = siblings.findIndex(item => item.id === entry.id);
const previous = siblings[index - 1];
const next = siblings[index + 1];
---
<BaseLayout title={entry.data.title} description={entry.data.description} article date={entry.data.date} updated={entry.data.updated}>
  <div class:list={['shell', 'article-grid', { wiki }]}>
    {wiki && <WikiSidebar />}
    <article class="article-body">
      <a class="back-link" href={`/${entry.collection}/`}>← {sectionNames[entry.collection]}</a>
      <header class="article-header"><span class="eyebrow">{entry.data.category} / {entry.data.status || 'GROWING THOUGHTS'}</span><h1>{entry.data.title}</h1><p class="article-description">{entry.data.description}</p><div class="article-meta"><span>windyx3</span><time datetime={entry.data.date.toISOString()}>{dateLabel(entry.data.date)}</time>{entry.data.updated && <span>更新于 {dateLabel(entry.data.updated)}</span>}</div><div class="tag-row">{entry.data.tags.map(tag => <a class="tag" href={tagUrl(tag)}>#{tag}</a>)}</div></header>
      {entry.data.sample && <p class="sample-notice">这是一篇示例内容，用来展示排版与内容组织，可替换为你的真实记录。</p>}
      {(entry.data.repo || entry.data.demo) && <div class="project-links">{entry.data.repo && <a class="text-link" href={entry.data.repo}>查看源码 ↗</a>}{entry.data.demo && <a class="text-link" href={entry.data.demo}>访问项目 ↗</a>}</div>}
      {headings.length > 0 && <details class="article-toc"><summary>本文目录</summary><ul>{headings.filter(h => h.depth === 2 || h.depth === 3).map(h => <li class:list={{ nested: h.depth === 3 }}><a href={`#${h.slug}`}>{h.text}</a></li>)}</ul></details>}
      <div class="prose"><slot /></div>
      <nav class="article-pagination" aria-label="相邻内容">{previous ? <a href={entryUrl(previous)}><small>← 更新的一篇</small>{previous.data.title}</a> : <span />}{next && <a href={entryUrl(next)}><small>更早的一篇 →</small>{next.data.title}</a>}</nav>
    </article>
  </div>
</BaseLayout>
